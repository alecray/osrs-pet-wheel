  { "name": "Herbi", "itemId": 21509, "source": "Herbiboar", "type": "SOLO", "rarity": 6500, "wikiUrl": "https://oldschool.runescape.wiki/w/Herbi", "defaultTags": ["skilling", "hunter"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 62.5, "assumedRate": false, "editable": true, "womSkill": "hunter", "methodNote": "Herbiboar harvesting with stamina potions (wiki: 59-66 catches/hour). Flat 1/6,500 per catch, not level-scaled. https://oldschool.runescape.wiki/w/Herbi, https://oldschool.runescape.wiki/w/Herbiboar" },
