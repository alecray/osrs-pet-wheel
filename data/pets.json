  { "name": "Lil' creator", "itemId": 25348, "source": "Soul Wars", "type": "GROUP", "rarity": 400, "wikiUrl": "https://oldschool.runescape.wiki/w/Lil'_creator", "defaultTags": ["minigame"], "attemptUnit": "game", "rollsPerAttempt": 1, "attemptsPerHour": 4, "assumedRate": true, "editable": false, "methodNote": "Soul Wars games with sufficient Zeal (owner-set rate: 1/400/game; neither the Soul Wars nor Lil' creator wiki page states the pet odds or exact zeal threshold directly). Game length is wiki-confirmed at up to 15 minutes -> 4 games/hr. https://oldschool.runescape.wiki/w/Soul_Wars, https://oldschool.runescape.wiki/w/Lil'_creator" },
  { "name": "Pet penance queen", "itemId": 12703, "source": "Barbarian Assault", "type": "GROUP", "rarity": 1000, "wikiUrl": "https://oldschool.runescape.wiki/w/Pet_penance_queen", "defaultTags": ["minigame"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 20, "assumedRate": true, "editable": false, "methodNote": "Barbarian Assault high-level gambles (wiki confirms 1/1,000 per high gamble). Gambles/hr depend on team role and coordination and aren't wiki-stated -- ~20/hr is a rough placeholder. https://oldschool.runescape.wiki/w/Barbarian_Assault, https://oldschool.runescape.wiki/w/Pet_penance_queen" },
