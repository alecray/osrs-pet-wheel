  { "name": "Baby chinchompa", "itemId": 13324, "source": "Hunter", "type": "SOLO", "rarity": 80283, "wikiUrl": "https://oldschool.runescape.wiki/w/Baby_chinchompa", "defaultTags": ["skilling", "hunter"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 800, "assumedRate": true, "editable": true, "womSkill": "hunter", "methodNote": "Black chinchompas via box trapping (OSRS Wiki: best pet odds among chinchompa colours at any level, though slower to catch than grey/red). Rate formula 1/(B - Lvl*25); black base 82,758 -> 1/80,283 at 99. ~800 catches/hr is an unverified estimate -- edit to your real rate. https://oldschool.runescape.wiki/w/Baby_chinchompa" },
  { "name": "Beaver", "itemId": 13322, "source": "Woodcutting", "type": "SOLO", "rarity": 69846, "wikiUrl": "https://oldschool.runescape.wiki/w/Beaver", "defaultTags": ["skilling", "woodcutting"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 571, "assumedRate": true, "editable": true, "womSkill": "woodcutting", "methodNote": "Ironwood trees, regular chopping (wiki: fastest method without tick manipulation). Base 1/72,321 -> 1/69,846 at 99. ~571 logs/hr assumes ~100,000 xp/hr (not confirmed ironwood-specific) / 175 xp per log -- edit to your real rate. https://oldschool.runescape.wiki/w/Beaver, https://oldschool.runescape.wiki/w/Ironwood_tree" },
  { "name": "Giant squirrel", "itemId": 20659, "source": "Agility", "type": "SOLO", "rarity": 7841, "wikiUrl": "https://oldschool.runescape.wiki/w/Giant_squirrel", "defaultTags": ["skilling", "agility"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 55, "assumedRate": false, "editable": true, "womSkill": "agility", "methodNote": "Penguin Agility Course laps (wiki: fastest method on average, ~142 hours / 7,841 laps expected). Rarity and rate both taken directly from that wiki-stated average. https://oldschool.runescape.wiki/w/Giant_squirrel" },
  { "name": "Heron", "itemId": 13320, "source": "Fishing", "type": "SOLO", "rarity": 76174, "wikiUrl": "https://oldschool.runescape.wiki/w/Heron", "defaultTags": ["skilling", "fishing"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 325, "assumedRate": true, "editable": true, "womSkill": "fishing", "methodNote": "Anglerfish with diabolic worms (wiki: fastest standard method; 2-tick manipulation is faster but undocumented). Base 1/78,649 -> 1/76,174 at 99. ~325 catches/hr assumes 39,000 xp/hr / 120 xp per fish -- edit to your real rate. https://oldschool.runescape.wiki/w/Heron" },
  { "name": "Rift guardian", "itemId": 20665, "source": "Runecraft", "type": "SOLO", "rarity": 1793283, "wikiUrl": "https://oldschool.runescape.wiki/w/Rift_guardian", "defaultTags": ["skilling", "runecraft"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 6600, "assumedRate": true, "editable": true, "womSkill": "runecrafting", "methodNote": "Mind runes via Mind Altar Teleport + essence pouches (wiki: fastest method excluding runners). 'All other runes' base 1/1,795,758 -> 1/1,793,283 at 99. ~6,600 runes/hr assumes 30k-43k xp/hr / 5.5 xp per rune -- edit to your real rate. https://oldschool.runescape.wiki/w/Rift_guardian, https://oldschool.runescape.wiki/w/Mind_rune" },
  { "name": "Rock golem", "itemId": 13321, "source": "Mining", "type": "SOLO", "rarity": 57525, "wikiUrl": "https://oldschool.runescape.wiki/w/Rock_golem", "defaultTags": ["skilling", "mining"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 2000, "assumedRate": true, "editable": true, "womSkill": "mining", "methodNote": "Volcanic Mine ore fragments (wiki: only slightly slower than gem-rock mining for the pet, far better xp at 85k-95k/hr). Base 1/60,000 -> 1/57,525 at 99. ~2,000 fragments/hr is an unverified estimate (wiki gives xp/hr, not fragments/hr) -- edit to your real rate. https://oldschool.runescape.wiki/w/Rock_golem, https://oldschool.runescape.wiki/w/Volcanic_Mine" },
  { "name": "Rocky", "itemId": 20663, "source": "Thieving", "type": "SOLO", "rarity": 254736, "wikiUrl": "https://oldschool.runescape.wiki/w/Rocky", "defaultTags": ["skilling", "thieving"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 1000, "assumedRate": true, "editable": true, "womSkill": "thieving", "methodNote": "Wiki names market stalls (Rellekka/Prifddinas/Draynor) as fastest but doesn't give their base chance, so this uses the documented Man/Woman pickpocket rate: base 1/257,211 -> 1/254,736 at 99. ~1,000 steals/hr is an unverified estimate -- edit to your real rate. https://oldschool.runescape.wiki/w/Rocky" },
  { "name": "Soup", "itemId": 31283, "source": "Sailing", "type": "SOLO", "rarity": 4691, "wikiUrl": "https://oldschool.runescape.wiki/w/Soup", "defaultTags": ["skilling", "sailing"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 9, "assumedRate": true, "editable": true, "womSkill": "sailing", "methodNote": "Courier tasks between Aldarin and Sunset Coast (wiki: best odds, 1/4,691 per task; doesn't appear level-scaled). Tasks/hr isn't documented for this exact route -- ~9/hr borrows the Summer Shore route's stated pace as a rough proxy. https://oldschool.runescape.wiki/w/Soup, https://oldschool.runescape.wiki/w/Sailing_training" },
  { "name": "Tangleroot", "itemId": 20661, "source": "Farming", "type": "SOLO", "rarity": 4525, "wikiUrl": "https://oldschool.runescape.wiki/w/Tangleroot", "defaultTags": ["skilling", "farming"], "attemptUnit": "action", "rollsPerAttempt": 1, "attemptsPerHour": 6, "assumedRate": true, "editable": true, "womSkill": "farming", "methodNote": "Cactus patch check-health rolls (wiki: base 1/7,000 -> 1/4,525 at 99; mixing fast-growing patches beats tree-only runs, which the wiki says can take 'upwards of two years'). ~6 checks/hr is a rough placeholder -- farming's bottleneck is real-time growth, not clicks -- edit heavily. https://oldschool.runescape.wiki/w/Tangleroot" },

